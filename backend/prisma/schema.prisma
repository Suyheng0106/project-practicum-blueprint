generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  EMPLOYER
}

enum EmploymentType {
  INTERNSHIP
  ENTRY_LEVEL
  PART_TIME
  FULL_TIME
}

enum WorkExperienceType {
  INTERNSHIP
  PART_TIME
  FULL_TIME
  FREELANCE
  VOLUNTEER
}

enum JobStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  email        String            @unique @db.VarChar(255)
  passwordHash String            @map("password_hash") @db.VarChar(255)
  role         Role
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at")

  profile      CandidateProfile?
  companies    Company[]

  @@map("users")
}

model CandidateProfile {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @unique @map("user_id") @db.Uuid
  fullName     String                 @map("full_name") @db.VarChar(100)
  bio          String?                @db.Text
  university   String?                @db.VarChar(150)
  major        String?                @db.VarChar(100)
  yearOfStudy  Int?                   @map("year_of_study")
  portfolioUrl String?                @map("portfolio_url") @db.VarChar(255)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @default(now()) @updatedAt @map("updated_at")

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       CandidateSkill[]
  projects     CandidateProject[]
  experiences  CandidateExperience[]
  achievements CandidateAchievement[]
  applications JobApplication[]
  savedJobs    SavedJob[]

  @@map("candidate_profiles")
}

model CandidateProject {
  id                 String           @id @default(uuid()) @db.Uuid
  candidateProfileId String           @map("candidate_profile_id") @db.Uuid
  title              String           @db.VarChar(150)
  description        String?          @db.Text
  projectUrl         String?          @map("project_url") @db.VarChar(255)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@map("candidate_projects")
}

model CandidateExperience {
  id                 String              @id @default(uuid()) @db.Uuid
  candidateProfileId String              @map("candidate_profile_id") @db.Uuid
  title              String              @db.VarChar(150)
  companyName        String              @map("company_name") @db.VarChar(150)
  employmentType     WorkExperienceType? @map("employment_type")
  location           String?             @db.VarChar(150)
  isCurrent          Boolean             @default(false) @map("is_current")
  startDate          DateTime            @map("start_date") @db.Date
  endDate            DateTime?           @map("end_date") @db.Date
  description        String?             @db.Text
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")

  candidateProfile   CandidateProfile    @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@map("candidate_experiences")
}

model CandidateAchievement {
  id                 String           @id @default(uuid()) @db.Uuid
  candidateProfileId String           @map("candidate_profile_id") @db.Uuid
  title              String           @db.VarChar(150)
  issuer             String?          @db.VarChar(150)
  issueDate          DateTime?        @map("issue_date") @db.Date
  description        String?          @db.Text
  certificateUrl     String?          @map("certificate_url") @db.VarChar(255)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@map("candidate_achievements")
}

model Skill {
  id                     String                   @id @default(uuid()) @db.Uuid
  name                   String                   @unique @db.VarChar(100)
  category               String                   @db.VarChar(50)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @default(now()) @updatedAt @map("updated_at")

  candidateSkills        CandidateSkill[]
  jobRequiredSkills      JobRequiredSkill[]
  preparationGuideSkills PreparationGuideSkill[]

  @@map("skills")
}

model CandidateSkill {
  id                 String           @id @default(uuid()) @db.Uuid
  candidateProfileId String           @map("candidate_profile_id") @db.Uuid
  skillId            String           @map("skill_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  skill              Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([candidateProfileId, skillId])
  @@map("candidate_skills")
}

model Company {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  name        String        @db.VarChar(150)
  industry    String?       @db.VarChar(100)
  location    String?       @db.VarChar(150)
  website     String?       @db.VarChar(255)
  description String?       @db.Text
  logoUrl     String?       @map("logo_url") @db.VarChar(255)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobListings JobListing[]

  @@map("companies")
}

model JobListing {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @map("company_id") @db.Uuid
  title              String             @db.VarChar(150)
  description        String             @db.Text
  category           String             @db.VarChar(100)
  employmentType     EmploymentType     @map("employment_type")
  location           String             @db.VarChar(150)
  isRemote           Boolean            @default(false) @map("is_remote")
  stipendAmountCents Int?               @map("stipend_amount_cents")
  status             JobStatus          @default(OPEN)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")

  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requiredSkills     JobRequiredSkill[]
  applications       JobApplication[]
  savedJobs          SavedJob[]

  @@map("job_listings")
}

model JobRequiredSkill {
  id           String     @id @default(uuid()) @db.Uuid
  jobListingId String     @map("job_listing_id") @db.Uuid
  skillId      String     @map("skill_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")

  jobListing   JobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([jobListingId, skillId])
  @@map("job_required_skills")
}

model JobApplication {
  id                 String            @id @default(uuid()) @db.Uuid
  jobListingId       String            @map("job_listing_id") @db.Uuid
  candidateProfileId String            @map("candidate_profile_id") @db.Uuid
  matchScore         Int               @map("match_score")
  status             ApplicationStatus @default(SUBMITTED)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at")

  jobListing         JobListing        @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  candidateProfile   CandidateProfile  @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([jobListingId, candidateProfileId])
  @@map("job_applications")
}

model SavedJob {
  id                 String           @id @default(uuid()) @db.Uuid
  candidateProfileId String           @map("candidate_profile_id") @db.Uuid
  jobListingId       String           @map("job_listing_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  jobListing         JobListing       @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  @@unique([candidateProfileId, jobListingId])
  @@map("saved_jobs")
}

model PreparationGuide {
  id        String                  @id @default(uuid()) @db.Uuid
  title     String                  @db.VarChar(150)
  category  String                  @db.VarChar(100)
  summary   String                  @db.VarChar(255)
  content   String                  @db.Text
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @default(now()) @updatedAt @map("updated_at")

  skills    PreparationGuideSkill[]

  @@map("preparation_guides")
}

model PreparationGuideSkill {
  id                 String           @id @default(uuid()) @db.Uuid
  preparationGuideId String           @map("preparation_guide_id") @db.Uuid
  skillId            String           @map("skill_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  preparationGuide   PreparationGuide @relation(fields: [preparationGuideId], references: [id], onDelete: Cascade)
  skill              Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([preparationGuideId, skillId])
  @@map("preparation_guide_skills")
}
